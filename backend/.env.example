# =========================================================================
# CognAI Backend Environment Configuration (.env.example)
# Copy this file to .env (or backend/.env) and populate with your credentials.
# =========================================================================

# --- Application Settings ---
PROJECT_NAME=CognAI API
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- Database Connections (PostgreSQL with pgvector, Redis, Neo4j) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=cognai
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cognai

REDIS_URL=redis://localhost:6379/0

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_URI=bolt://localhost:7687

# --- LLM Providers & Routing ---
# Active options for LLM_PROVIDER: bedrock | groq | cloudflare | gemini
LLM_PROVIDER=bedrock

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_MODEL=qwen.qwen3-32b-v1:0
AWS_BEDROCK_VISION_MODEL=global.amazon.nova-2-lite-v1:0
# Optional Bedrock bearer API key (if using API Gateway endpoint)
AWS_BEDROCK_API_KEY=

# Groq (Low-latency conversational generation)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Optional background fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (Optional)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# --- Authentication & Google OAuth2 ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Email / SMTP Settings (OTP Verification) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=noreply@cognai.local
